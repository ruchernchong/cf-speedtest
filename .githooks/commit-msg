#!/bin/sh
# Enforce Conventional Commits: type(scope)?: subject
# https://www.conventionalcommits.org/

msg_file="$1"
msg=$(head -n1 "$msg_file")

# Allow merge and revert commits produced by git itself
case "$msg" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: .+'

if ! printf '%s\n' "$msg" | grep -Eq "$pattern"; then
  echo "Invalid commit message: $msg" >&2
  echo "" >&2
  echo "Use Conventional Commits:" >&2
  echo "  type(scope)?: subject" >&2
  echo "" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "Example: fix: handle empty upload response" >&2
  exit 1
fi
